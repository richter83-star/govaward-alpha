# GovAward Alpha Engine — Environment Configuration
# Copy to .env and fill in your values.

# SAM.gov API key — get one free at https://sam.gov/content/entity-registration
SAM_API_KEY=your_sam_api_key_here

# Google Gemini AI — generates contract quality & materiality narrative
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SEC EDGAR fair-access contact. SEC asks automated clients to identify
# themselves; without it the ticker download may be throttled or blocked.
SEC_CONTACT_EMAIL=

# Core filter thresholds
AWARD_MIN_AMOUNT=50000000
LOOKBACK_DAYS=3

# Market cap range for alerts (ignore mega-caps by default)
MARKET_CAP_MIN=50000000
MARKET_CAP_MAX=10000000000

# Minimum materiality score to fire an alert (0–100)
ALERT_MIN_SCORE=70

# SQLite database path (relative or absolute)
DB_PATH=govaward.db

# Cache directory for SEC tickers and market data
CACHE_DIR=.cache

# --- Email Notifications ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# --- Telegram Notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord Notifications ---
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# Dashboard password (HTTP Basic, any username)
GOVAWARD_DASH_PASSWORD=
# LIVE trading is locked unless this is exactly: yes
GOVAWARD_ALLOW_LIVE=no

# Sources switched off on purpose (comma-separated): sam_gov, usaspending, defense_daily
GOVAWARD_PARKED_SOURCES=
